# Supabase - https://supabase.com/dashboard/project/_/settings/api adresinden al
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key (sunucu tarafi islemler icin onerilir; ASLA istemciye sizdirmayin)
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot (opsiyonel, gunluk hatirlatma icin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Web Push bildirimleri (opsiyonel ama onerilir)
# Anahtar uretmek icin: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:sizin@mailiniz.com

# Cron guvenligi - rastgele uzun bir deger girin (Vercel bunu cron isteklerine otomatik ekler)
CRON_SECRET=

# Claude API (opsiyonel, OCR text parse için)
ANTHROPIC_API_KEY=

# Google Vision API (OCR metin okuma için)
GOOGLE_VISION_API_KEY=
